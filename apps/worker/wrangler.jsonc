{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kebabarium",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-20",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "../web/dist/web/browser",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/__scheduled"] // /__scheduled: local `wrangler dev --test-scheduled` trigger
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "kebabarium", "database_id": "4f50f9c0-d2c0-4d38-9976-7b8038522c57", "migrations_dir": "migrations" }
  ],
  "triggers": { "crons": ["0 * * * *", "*/10 * * * *"] },
  "observability": { "enabled": true },
  "vars": { "ENVIRONMENT": "production" },
  "env": {
    "dev": {
      "vars": { "ENVIRONMENT": "dev" },
      "d1_databases": [
        { "binding": "DB", "database_name": "kebabarium", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }
      ],
      "triggers": { "crons": [] }
    }
  }
}
